# Frontend: somente configurações públicas.
# Desenvolvimento: o proxy do Vite encaminha /api para localhost:3000.
VITE_API_URL=/api

# Na Vercel, configure a URL pública do backend com /api no fim:
# VITE_API_URL=https://komanda-backend.vercel.app/api
# DATABASE_URL e credenciais do Atlas ficam SOMENTE no backend.
